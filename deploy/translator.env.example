# /etc/translator/translator.env
# Read by translator.service. Do not put API keys or HF tokens in this file.

# ---- gateway ----
TRANSLATOR_PORT=18080
TRANSLATOR_SOCKET_PATH=/run/translator/worker.sock
TRANSLATOR_KEY_FILE=/etc/translator/keys.json

# Tailscale Funnel sets X-Forwarded-For. The gateway listens only on
# 127.0.0.1, so only local tailscaled can connect. This makes the failed-auth
# IP limiter see the real public client instead of 127.0.0.1.
TRANSLATOR_CLIENT_IP_HEADER=X-Forwarded-For

# Log the first request's headers once, with credential headers redacted.
TRANSLATOR_DEBUG_HEADERS=false

# ---- lifecycle / limits ----
TRANSLATOR_IDLE_TIMEOUT=10m
TRANSLATOR_STARTUP_TIMEOUT=120s
TRANSLATOR_COLD_START_WAIT=90s
TRANSLATOR_TRANSLATE_TIMEOUT=60s
TRANSLATOR_SHUTDOWN_GRACE=10s
TRANSLATOR_STARTUP_COOLDOWN=30s

TRANSLATOR_MAX_BODY_BYTES=16384
TRANSLATOR_MAX_AUDIO_BYTES=26214400
TRANSLATOR_MAX_TEXT_RUNES=2000
TRANSLATOR_WHISPER_MODEL=openai/whisper-small
TRANSLATOR_RATE_LIMIT_PER_MINUTE=30
TRANSLATOR_RATE_LIMIT_BURST=30
TRANSLATOR_AUTH_FAIL_LIMIT=10
TRANSLATOR_AUTH_FAIL_WINDOW=1m
TRANSLATOR_AUTH_BLOCK_DURATION=1m
TRANSLATOR_QUEUE_DEPTH=8

# ---- worker ----
TRANSLATOR_WORKER_PYTHON=/opt/translator/venv/bin/python
TRANSLATOR_WORKER_SCRIPT=/opt/translator/worker/worker.py
TRANSLATOR_MODEL_CACHE=/var/lib/translator/hf
TRANSLATOR_MODEL_REVISION=ffb7582b6d43791f1fb26b2153fc065f2e9ea575
TRANSLATOR_BEAMS=4
TRANSLATOR_BATCH_SIZE=4
TRANSLATOR_MAX_LENGTH=256
TRANSLATOR_MAX_CHUNK_CHARS=400
# Positive values make the worker a more likely OOM victim than the gateway.
TRANSLATOR_OOM_SCORE_ADJ=500
